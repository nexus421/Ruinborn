{
  "pot": true,
  "paddingX": 4,
  "paddingY": 4,
  "edgePadding": true,
  "duplicatePadding": false,
  "rotation": false,
  "minWidth": 16,
  "minHeight": 16,
  "maxWidth": 2048,
  "maxHeight": 2048,
  "square": false,
  "stripWhitespaceX": false,
  "stripWhitespaceY": false,
  "alphaThreshold": 0,
  "filterMin": "MipMapLinearNearest",
  "filterMag": "Linear",
  "wrapX": "ClampToEdge",
  "wrapY": "ClampToEdge",
  "format": "RGBA8888",
  "alias": true,
  "outputFormat": "png",
  "ignoreBlankImages": false,
  "fast": false,
  "combineSubdirectories": true,
  "flattenPaths": false,
  "premultiplyAlpha": false,
  "useIndexes": true,
  "bleed": true,
  "bleedIterations": 2,
  "limitMemory": true
}